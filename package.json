{
  "name": "desafio-qa-accenture",
  "version": "1.0.0",
  "private": true,
  "description": "Automação de testes de API e Frontend para o desafio técnico de QA da Accenture.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "test": "cypress run --browser chrome",
    "test:challenge": "cypress run --browser chrome --spec \"cypress/e2e/api/bookstore.cy.js,cypress/e2e/frontend/practice-form.cy.js,cypress/e2e/frontend/web-tables.cy.js,cypress/e2e/frontend/progress-bar.cy.js,cypress/e2e/frontend/sortable.cy.js,cypress/e2e/frontend/browser-windows.cy.js\"",
    "test:smoke": "cypress run --browser chrome --spec \"cypress/e2e/**/smoke.cy.js\" --expose smokeOnly=true",
    "test:api": "cypress run --browser chrome --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:bookstore": "cypress run --browser chrome --spec \"cypress/e2e/api/bookstore.cy.js\"",
    "test:frontend": "cypress run --browser chrome --spec \"cypress/e2e/frontend/**/*.cy.js\"",
    "test:frontend:demoqa": "cypress run --browser chrome --spec \"cypress/e2e/frontend/practice-form.cy.js,cypress/e2e/frontend/web-tables.cy.js\"",
    "test:progress-bar": "cypress run --browser chrome --spec \"cypress/e2e/frontend/progress-bar.cy.js\"",
    "test:sortable": "cypress run --browser chrome --spec \"cypress/e2e/frontend/sortable.cy.js\"",
    "test:browser-windows": "cypress run --browser chrome --spec \"cypress/e2e/frontend/browser-windows.cy.js\"",
    "cy:open": "cypress open --e2e",
    "cy:verify": "cypress verify",
    "cy:info": "cypress info"
  },
  "devDependencies": {
    "@cypress/grep": "7.0.0",
    "@cypress/puppeteer": "0.1.10",
    "cypress": "16.2.0",
    "puppeteer-core": "25.16.0"
  },
  "overrides": {
    "@cypress/puppeteer": {
      "puppeteer-core": "$puppeteer-core"
    }
  },
  "allowScripts": {
    "cypress@16.2.0": true
  }
}
